+static HRESULT user_ensure_device_title( struct XUser *impl )
+{
+    GUID id;
+    char device_id[40], *body=NULL, *access=NULL, *device=NULL;
+    UCHAR *response=NULL; SIZE_T response_size=0, body_size=0;
+    IJsonObject *object=NULL;
+    HSTRING replacement=NULL;
+    ULONGLONG expiry;
+    HRESULT hr=S_OK;
+    if(!impl->xboxDeviceToken || impl->xboxDeviceExpiry <= xuser_current_time()+3000000000ULL)
+    {
+        if (!(access=user_token_utf8(impl->msaDeviceRps))) {hr=E_ACCESSDENIED;goto cleanup;}
+        body_size=strlen(access)+1024;
+        if(!(body=calloc(1,body_size))) {hr=E_OUTOFMEMORY;goto cleanup;}
+        snprintf(body,body_size,"{\"RelyingParty\":\"http://auth.xboxlive.com\",\"TokenType\":\"JWT\",\"Properties\":{\"AuthMethod\":\"RPS\",\"RpsTicket\":\"%s\",\"SiteName\":\"user.auth.xboxlive.com\",\"Version\":\"10.0.19045\",\"ProofKey\":%.*s}}",access,(int)(PROOF_KEY_SIZE),impl->proofKey);
+        hr=user_auth_post(impl,L"device.auth.xboxlive.com",L"/device/authenticate",body,&response,&response_size);
+        TRACE("Device authentication status %#lx.\n",hr);
+        if(FAILED(hr)) goto cleanup;
+        if(FAILED(hr=parse_json((char*)response,response_size,&object))) goto cleanup;
+        if(FAILED(hr=get_json_string(object,L"Token",&replacement))) goto cleanup;
+        if(!WindowsGetStringLen(replacement)) {hr=E_UNEXPECTED;goto cleanup;}
+        if(FAILED(hr=user_read_token_expiry(object,&expiry))) goto cleanup;
+        if(impl->xboxDeviceToken) WindowsDeleteString(impl->xboxDeviceToken);
+        impl->xboxDeviceToken=replacement;replacement=NULL;impl->xboxDeviceExpiry=expiry;
+        if(impl->xboxTitleToken) WindowsDeleteString(impl->xboxTitleToken);
+        impl->xboxTitleToken=NULL;impl->xboxTitleExpiry=0;
+        IJsonObject_Release(object);object=NULL;
+        memset(response,0,response_size);free(response);response=NULL;
+        memset(body,0,body_size);free(body);body=NULL;
+        memset(access,0,strlen(access));free(access);access=NULL;
+    }
+    if(!impl->xboxTitleToken || impl->xboxTitleExpiry <= xuser_current_time()+3000000000ULL)
+    {
+        if(!(access=user_token_utf8(impl->accessToken)) || !(device=user_token_utf8(impl->xboxDeviceToken))) {hr=E_OUTOFMEMORY;goto cleanup;}
+        body_size=strlen(access)+strlen(device)+1024;
+        if(!(body=calloc(1,body_size))) {hr=E_OUTOFMEMORY;goto cleanup;}
+        snprintf(body,body_size,"{\"RelyingParty\":\"http://auth.xboxlive.com\",\"TokenType\":\"JWT\",\"Properties\":{\"DeviceToken\":\"%s\",\"TitleId\":%lu,\"ProofKey\":%.*s}}",device,titleId,(int)(PROOF_KEY_SIZE),impl->proofKey);
+        hr=user_auth_post(impl,L"title.auth.xboxlive.com",L"/title/authenticate",body,&response,&response_size);
+        TRACE("Title authentication status %#lx.\n",hr);
+        if(FAILED(hr)) goto cleanup;
+        if(FAILED(hr=parse_json((char*)response,response_size,&object))) goto cleanup;
+        if(FAILED(hr=get_json_string(object,L"Token",&replacement))) goto cleanup;
+        if(!WindowsGetStringLen(replacement)) {hr=E_UNEXPECTED;goto cleanup;}
+        if(FAILED(hr=user_read_token_expiry(object,&expiry))) goto cleanup;
+        if(impl->xboxTitleToken) WindowsDeleteString(impl->xboxTitleToken);
+        impl->xboxTitleToken=replacement;replacement=NULL;impl->xboxTitleExpiry=expiry;
+    }
+cleanup:
+    if(replacement) WindowsDeleteString(replacement);
+    if(object) IJsonObject_Release(object);
+    if(response) {memset(response,0,response_size);free(response);}
+    if(body) {memset(body,0,body_size);free(body);}
+    if(access) {memset(access,0,strlen(access));free(access);}
+    if(device) {memset(device,0,strlen(device));free(device);}
+    return hr;
+}
