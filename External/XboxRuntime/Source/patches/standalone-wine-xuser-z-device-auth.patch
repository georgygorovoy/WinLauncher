+/* Authentication requests bind the genuine device/title tokens to this user's
+ * generated proof key. Never log request bodies, tokens or signatures. */
+static HRESULT user_auth_post( struct XUser *impl, const WCHAR *host, const WCHAR *path,
+                               char *body, UCHAR **response, SIZE_T *response_size )
+{
+    BYTE signature[76] = {0};
+    FILETIME timestamp;
+    ULONGLONG ticks;
+    char path_utf8[128], encoded[105] = {0};
+    WCHAR headers[256];
+    BYTE *data, *ptr;
+    SIZE_T len, body_len = min( strlen(body), 0x2000 );
+    HRESULT hr;
+    if (!WideCharToMultiByte(CP_UTF8,0,path,-1,path_utf8,sizeof(path_utf8),NULL,NULL)) return E_INVALIDARG;
+    len = 14 + 5 + strlen(path_utf8) + 1 + 1 + body_len + 1;
+    if (!(data = calloc(1,len))) return E_OUTOFMEMORY;
+    data[3] = signature[3] = 1;
+    GetSystemTimeAsFileTime(&timestamp);
+    ticks = ((ULONGLONG)timestamp.dwHighDateTime << 32) | timestamp.dwLowDateTime;
+    for (unsigned i=0;i<8;i++) data[5+i] = signature[4+i] = ticks >> (56-8*i);
+    ptr=data+14;
+    memcpy(ptr,"POST",4);ptr+=5;
+    memcpy(ptr,path_utf8,strlen(path_utf8));ptr+=strlen(path_utf8)+2;
+    memcpy(ptr,body,body_len);
+    hr=IUser_SignData(&impl->IUser_iface,len,data,64,signature+12);
+    memset(data,0,len);free(data);
+    if(FAILED(hr)) return hr;
+    if(FAILED(hr=encode_base64(76,signature,104,encoded,TRUE))) return hr;
+    swprintf(headers,ARRAY_SIZE(headers),L"Content-Type: application/json\r\nX-Xbl-Contract-Version: 1\r\nSignature: %S\r\n",encoded);
+    hr=http_request(L"POST",host,path,body,headers,ACCEPT_JSON,response,response_size);
+    memset(signature,0,sizeof(signature));memset(encoded,0,sizeof(encoded));memset(headers,0,sizeof(headers));
+    return hr;
+}
+
+static char *user_token_utf8( HSTRING token )
+{
+    const WCHAR *wide=WindowsGetStringRawBuffer(token,NULL);
+    int len=WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,wide,-1,NULL,0,NULL,NULL);
+    char *text;
+    if(!len || !(text=malloc(len))) return NULL;
+    if(!WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,wide,-1,text,len,NULL,NULL)) { free(text);return NULL; }
+    return text;
+}
