+/* No UI is permitted during background credential renewal. The helper retains
+ * the account's refresh credentials; the game process only receives an access token. */
+static HRESULT user_refresh_access_token( struct XUser *impl )
+{
+#if XODUS_INTEROP
+    if (impl->usesXodus)
+    {
+        IAsyncOperation_IMsaTokenResponse *operation = NULL;
+        IMsaTokenResponse *response = NULL;
+        const char *access = NULL;
+        HSTRING replacement = NULL;
+        DWORD status;
+        HRESULT hr;
+
+        hr = IXodusService_MsaTokenRequest( xodus_service, msaAppId, FALSE, fullTrust, &operation );
+        if (FAILED(hr)) goto cleanup;
+        status = await_IAsyncOperation_IMsaTokenResponse( operation, IPC_REQUEST_TIMEOUT_MS );
+        if (status)
+        {
+            hr = status == WAIT_TIMEOUT ? HRESULT_FROM_WIN32( ERROR_TIMEOUT ) : E_ABORT;
+            goto cleanup;
+        }
+        if (FAILED(hr = IAsyncOperation_IMsaTokenResponse_GetResults( operation, &response ))) goto cleanup;
+        if (FAILED(hr = IMsaTokenResponse_get_Token( response, &access ))) goto cleanup;
+        if (!access || !*access) { hr = E_UNEXPECTED; goto cleanup; }
+        if (FAILED(hr = MultiByteToHSTRING( access, strlen( access ), &replacement ))) goto cleanup;
+        if (impl->accessToken) WindowsDeleteString( impl->accessToken );
+        impl->accessToken = replacement;
+
+    cleanup:
+        if (access) { memset( (void *)access, 0, strlen( access ) ); free( (void *)access ); }
+        if (response) IMsaTokenResponse_Release( response );
+        if (operation) IAsyncOperation_IMsaTokenResponse_Release( operation );
+        return hr;
+    }
+#endif
+    return user_RefreshOAuthToken( &impl->IUser_iface );
+}
