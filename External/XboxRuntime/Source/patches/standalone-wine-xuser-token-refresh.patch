+/* Call with xstsLock held exclusively after publishing the user. Keep the
+ * proof key unchanged: each renewed XSTS token is bound to that existing key. */
+static HRESULT user_ensure_xsts_token( struct XUser *impl, const char *audience, BOOL force )
+{
+    ULONGLONG now = xuser_current_time();
+    HRESULT hr;
+
+    if (!xuser_token_needs_refresh( impl->xstsToken != NULL, impl->xstsRelyingParty,
+            audience, impl->xstsExpiry, now, force )) return S_OK;
+    if (force && impl->xstsRelyingParty && !strcmp( impl->xstsRelyingParty, audience ))
+        impl->xstsExpiry = 0; /* A rejected token must not re-enter the cache after a failed retry. */
+    if (!impl->userToken || xuser_expiry_needs_refresh( impl->userTokenExpiry, now ))
+    {
+        TRACE( "Renewing parent Xbox user token silently.\n" );
+        if (FAILED(hr = user_refresh_access_token( impl ))) return hr;
+        if (FAILED(hr = user_RequestUserToken( &impl->IUser_iface ))) return hr;
+        /* Validate the renewed identity with the Xbox audience before asking
+         * for an audience that might omit xid, and refresh its policy cache. */
+        if (FAILED(hr = user_request_xsts_token( impl, "http://xboxlive.com" ))) return hr;
+        if (!strcmp( audience, "http://xboxlive.com" )) return S_OK;
+    }
+    TRACE( "Renewing XSTS token, forced %u.\n", force );
+    return user_request_xsts_token( impl, audience );
+}
+
+static HRESULT user_refresh_policy( struct XUser *impl )
+{
+    ULONGLONG now = xuser_current_time();
+    HRESULT hr;
+
+    if (!xuser_expiry_needs_refresh( impl->xboxClaimsExpiry, now )) return S_OK;
+    if (impl->xboxPolicyRetryAfter > GetTickCount64())
+        hr = impl->xboxPolicyRefreshError;
+    else
+    {
+        hr = user_ensure_xsts_token( impl, "http://xboxlive.com", TRUE );
+        if (FAILED(hr))
+        {
+            impl->xboxPolicyRefreshError = hr;
+            impl->xboxPolicyRetryAfter = GetTickCount64() + 30000;
+        }
+    }
+    /* A failed proactive refresh can use an unexpired claim. Never extend its
+     * server-supplied lifetime, and do not hammer the service on repeated checks. */
+    if (FAILED(hr) && impl->xboxClaimsExpiry > xuser_current_time()) return S_OK;
+    return hr;
 }
 
