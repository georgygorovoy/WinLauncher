@@ -0,0 +1,29 @@
+/* Token cache lifetime rules, shared with the regression tests.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef __WINE_XUSER_REFRESH_H
+#define __WINE_XUSER_REFRESH_H
+
+#define XUSER_REFRESH_MARGIN (300ULL * 10000000)
+
+static ULONGLONG xuser_current_time(void)
+{
+    FILETIME now;
+    GetSystemTimeAsFileTime(&now);
+    return ((ULONGLONG)now.dwHighDateTime << 32) | now.dwLowDateTime;
+}
+
+static BOOL xuser_expiry_needs_refresh(ULONGLONG expiry, ULONGLONG now)
+{
+    /* Subtraction after the boundary check avoids unsigned wraparound. */
+    return expiry <= now || expiry - now <= XUSER_REFRESH_MARGIN;
+}
+
+static BOOL xuser_token_needs_refresh(BOOL present, const char *cached_audience,
+        const char *requested_audience, ULONGLONG expiry, ULONGLONG now, BOOL force)
+{
+    return force || !present || !cached_audience ||
+            strcmp(cached_audience, requested_audience) || xuser_expiry_needs_refresh(expiry, now);
+}
+
+#endif
