+    if(SUCCEEDED(hr) && !op->threading) hr=E_UNEXPECTED;
+    if(SUCCEEDED(hr)) hr=IXThreadingImpl_XAsyncBegin(op->threading,async,op,identity,"StoreRequest",store_provider);
+    if(FAILED(hr)) free_operation(op);
+    return hr;
+}
