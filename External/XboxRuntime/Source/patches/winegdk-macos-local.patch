+static HRESULT WINAPI game_save_ReadBlobData(IXGameSaveImpl *iface, XGameSaveContainerHandle container, const char **names, UINT32 *count, SIZE_T size, XGameSaveBlob *blobs)
+{
+    struct local_handle *h;struct local_snapshot *s=NULL;struct local_blob *b;struct local_blob **selected=NULL;
+    HANDLE lock=INVALID_HANDLE_VALUE;HRESULT hr;UINT32 requested,n=0,i;SIZE_T required=0;BYTE *cursor;
+    TRACE("%s enter.\n", __func__);
+    if(!count)return trace_result(__func__, E_POINTER);requested=*count;*count=0;
+    TRACE("ReadBlobData requested=%u bufferSize=%Iu named=%d.\n",requested,size,names!=NULL);
+    if(!blobs)return trace_result(__func__, E_POINTER);
+    if(names)for(i=0;i<requested;i++)if(!valid_name(names[i],FALSE))return trace_result(__func__, E_INVALIDARG);
+    AcquireSRWLockExclusive(&local_lock);hr=usable_handle(container,CONTAINER_HANDLE,&h);
+    if(SUCCEEDED(hr))hr=storage_lock(h->provider,&lock);
+    if(SUCCEEDED(hr))hr=load_container(h->provider,h->name,&s);
+    if(hr==S_FALSE)hr=GS_BLOB_NOT_FOUND;
+    if(lock!=INVALID_HANDLE_VALUE)CloseHandle(lock);ReleaseSRWLockExclusive(&local_lock);
+    if(FAILED(hr))goto done;
