+}
+static void close_local(void *id,unsigned int kind)
+{
+    struct local_handle **cur,*h;
+    AcquireSRWLockExclusive(&local_lock);
+    for(cur=&local_handles;(h=*cur);cur=&h->next) if(h->id==(ULONG_PTR)id && h->kind==kind) {
+        *cur=h->next;
+        if(kind==PROVIDER_HANDLE) h->provider->closed=TRUE;
+        release_provider(h->provider);free(h->name);free(h->display);free_blobs(h->changes);free(h);break;
+    }
+    ReleaseSRWLockExclusive(&local_lock);
+}
+static HRESULT create_local_provider(XUserHandle user,const char *scid,XGameSaveProviderHandle *out)
+{
+    WCHAR scid_w[37],xuid_w[17];
+    UINT64 xuid=0;
+    DWORD n;
+    HRESULT hr;
+    struct local_provider *p;
+    *out=NULL;
+    if(!local_enabled()) return E_NOTIMPL;
+    if(!user || !normalize_scid(scid,scid_w)) return E_INVALIDARG;
+    p=calloc(1,sizeof(*p));if(!p) return E_OUTOFMEMORY;
+    hr=QueryApiImpl(&CLSID_XUserImpl,&IID_IXUserImpl,(void **)&p->users);
+    if(FAILED(hr)||!p->users) { free(p);return FAILED(hr)?hr:E_UNEXPECTED; }
+    hr=IXUserImpl_XUserGetId(p->users,user,&xuid);
+    if(SUCCEEDED(hr)&&!xuid) hr=E_ACCESSDENIED;
+    if(SUCCEEDED(hr)) hr=IXUserImpl_XUserDuplicateHandle(p->users,user,&p->user);
+    if(FAILED(hr)) { IXUserImpl_Release(p->users);free(p);return hr; }
+    p->refs=1;
+    n=GetEnvironmentVariableW(L"LOCALAPPDATA",p->root,ARRAY_SIZE(p->root));
+    if(!n || n>=ARRAY_SIZE(p->root)) hr=HRESULT_FROM_WIN32(ERROR_PATH_NOT_FOUND);
+    if(SUCCEEDED(hr)) hr=append_dir(p->root,ARRAY_SIZE(p->root),L"WineGDK");
+    if(SUCCEEDED(hr)) hr=append_dir(p->root,ARRAY_SIZE(p->root),L"LocalGameSave");
+    if(SUCCEEDED(hr)) hr=append_dir(p->root,ARRAY_SIZE(p->root),L"v1");
+    for(n=0;n<16;n++) xuid_w[15-n]=L"0123456789abcdef"[(xuid>>(n*4))&15];xuid_w[16]=0;
+    if(SUCCEEDED(hr)) hr=append_dir(p->root,ARRAY_SIZE(p->root),xuid_w);
+    if(SUCCEEDED(hr)) hr=append_dir(p->root,ARRAY_SIZE(p->root),scid_w);
+    if(SUCCEEDED(hr)) { AcquireSRWLockExclusive(&local_lock);hr=new_handle(PROVIDER_HANDLE,p,NULL,NULL,(void **)out);ReleaseSRWLockExclusive(&local_lock); }
+    release_provider(p);
+    TRACE("Local-only provider initialization hr=%#lx; cloud sync unavailable.\n",hr);
+    return hr;
+}
+static HRESULT sha256(const BYTE *data,UINT32 size,BYTE digest[32])
+{
+    BCRYPT_ALG_HANDLE alg=NULL;
+    NTSTATUS st=BCryptOpenAlgorithmProvider(&alg,BCRYPT_SHA256_ALGORITHM,NULL,0);
+    if(st>=0) { st=BCryptHash(alg,NULL,0,(BYTE *)data,size,digest,32);BCryptCloseAlgorithmProvider(alg,0); }
+    return st>=0?S_OK:E_FAIL;
+}
+static HRESULT container_path(struct local_provider *p,const char *name,WCHAR path[1200])
+{
+    BYTE digest[32];WCHAR file[68];unsigned int i;HRESULT hr=sha256((const BYTE *)name,strlen(name),digest);
+    if(FAILED(hr)) return hr;
+    for(i=0;i<32;i++) { file[2*i]=L"0123456789abcdef"[digest[i]>>4];file[2*i+1]=L"0123456789abcdef"[digest[i]&15]; }
+    memcpy(file+64,L".gs",4*sizeof(WCHAR));
+    if(_snwprintf(path,1200,L"%s\\%s",p->root,file)<0) return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    return S_OK;
+}
+static HRESULT storage_lock(struct local_provider *p,HANDLE *out)
+{
+    WCHAR path[1200];_snwprintf(path,ARRAY_SIZE(path),L"%s\\.lock",p->root);
+    *out=CreateFileW(path,GENERIC_READ|GENERIC_WRITE,0,NULL,OPEN_ALWAYS,FILE_ATTRIBUTE_NORMAL|FILE_FLAG_OPEN_REPARSE_POINT,NULL);
+    if(*out==INVALID_HANDLE_VALUE) return winerr();
+    { BY_HANDLE_FILE_INFORMATION info;
+      if(!GetFileInformationByHandle(*out,&info) || (info.dwFileAttributes&FILE_ATTRIBUTE_REPARSE_POINT)) { CloseHandle(*out);*out=INVALID_HANDLE_VALUE;return E_ACCESSDENIED; } }
+    return S_OK;
+}
+static BOOL take_bytes(const BYTE **cursor,const BYTE *end,void *out,SIZE_T size)
+{
+    if((SIZE_T)(end-*cursor)<size) return FALSE;
+    if(out) memcpy(out,*cursor,size);*cursor+=size;return TRUE;
+}
+static char *take_string(const BYTE **cursor,const BYTE *end,UINT32 limit)
+{
+    UINT32 size;char *s;
+    if(!take_bytes(cursor,end,&size,4)||size>limit||(SIZE_T)(end-*cursor)<size) return NULL;
+    s=malloc((SIZE_T)size+1);if(!s) return NULL;
+    memcpy(s,*cursor,size);s[size]=0;*cursor+=size;
+    if(memchr(s,0,size)) { free(s);return NULL; } return s;
+}
+static UINT64 snapshot_bytes(struct local_snapshot *s)
+{
+    UINT64 n=0;struct local_blob *b;for(b=s->blobs;b;b=b->next)n+=b->size;return n;
+}
+static HRESULT load_path(const WCHAR *path,struct local_snapshot **out)
+{
+    HANDLE file;LARGE_INTEGER size;DWORD got;BYTE *buffer=NULL,digest[32];const BYTE *cursor,*end;UINT32 payload,count,i;
+    struct local_snapshot *s=NULL;struct local_blob **tail;HRESULT hr=HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    *out=NULL;
+    file=CreateFileW(path,GENERIC_READ,FILE_SHARE_READ,NULL,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL|FILE_FLAG_OPEN_REPARSE_POINT,NULL);
+    if(file==INVALID_HANDLE_VALUE) return GetLastError()==ERROR_FILE_NOT_FOUND?S_FALSE:winerr();
+    { BY_HANDLE_FILE_INFORMATION info;
+      if(!GetFileInformationByHandle(file,&info)||(info.dwFileAttributes&FILE_ATTRIBUTE_REPARSE_POINT)) { CloseHandle(file);return E_ACCESSDENIED; } }
+    if(!GetFileSizeEx(file,&size)||size.QuadPart<44||size.QuadPart>LOCAL_QUOTA+UPDATE_LIMIT) goto done;
+    buffer=malloc(size.QuadPart);if(!buffer) { hr=E_OUTOFMEMORY;goto done; }
+    if(!ReadFile(file,buffer,(DWORD)size.QuadPart,&got,NULL)||got!=size.QuadPart) { hr=winerr();goto done; }
+    memcpy(&payload,buffer+8,4);
+    if(memcmp(buffer,"WGDKLGS1",8)||payload!=size.QuadPart-44) goto done;
+    if(FAILED(sha256(buffer+44,payload,digest))||memcmp(digest,buffer+12,32)) goto done;
+    cursor=buffer+44;end=cursor+payload;
+    s=calloc(1,sizeof(*s));if(!s) { hr=E_OUTOFMEMORY;goto done; }
+    if(!(s->name=take_string(&cursor,end,256))||!valid_name(s->name,TRUE)||!(s->display=take_string(&cursor,end,4096))) goto done;
+    if(!take_bytes(&cursor,end,&s->modified,8)||!take_bytes(&cursor,end,&count,4)||count>(SIZE_T)(end-cursor)/8) goto done;
+    tail=&s->blobs;
+    for(i=0;i<count;i++) {
+        struct local_blob *b=calloc(1,sizeof(*b)),*prev;
+        if(!b) { hr=E_OUTOFMEMORY;goto done; } *tail=b;tail=&b->next;
+        if(!(b->name=take_string(&cursor,end,256))||!valid_name(b->name,FALSE)||!take_bytes(&cursor,end,&b->size,4)||b->size>UPDATE_LIMIT||(SIZE_T)(end-cursor)<b->size) goto done;
+        for(prev=s->blobs;prev!=b;prev=prev->next) if(!strcmp(prev->name,b->name)) goto done;
+        b->data=malloc(b->size?b->size:1);if(!b->data) { hr=E_OUTOFMEMORY;goto done; }
+        if(!take_bytes(&cursor,end,b->data,b->size)) goto done;
+    }
+    if(cursor!=end || snapshot_bytes(s)>LOCAL_QUOTA) goto done;
+    *out=s;s=NULL;hr=S_OK;
+done:
+    CloseHandle(file);free(buffer);free_snapshot(s);return hr;
+}
+static HRESULT load_container(struct local_provider *p,const char *name,struct local_snapshot **out)
+{
+    WCHAR path[1200];HRESULT hr=container_path(p,name,path);*out=NULL;
+    if(SUCCEEDED(hr)) hr=load_path(path,out);
+    if(hr==S_OK && strcmp((*out)->name,name)) { free_snapshot(*out);*out=NULL;hr=HRESULT_FROM_WIN32(ERROR_INVALID_DATA); }
+    return hr;
+}
+static HRESULT list_containers(struct local_provider *p,struct local_snapshot **out,UINT64 *used)
+{
+    WCHAR pattern[1200],path[1200];WIN32_FIND_DATAW info;HANDLE find;struct local_snapshot **tail=out;HRESULT hr=S_OK;
+    *out=NULL;if(used)*used=0;
+    _snwprintf(pattern,ARRAY_SIZE(pattern),L"%s\\*.gs",p->root);
+    find=FindFirstFileW(pattern,&info);
+    if(find==INVALID_HANDLE_VALUE) return GetLastError()==ERROR_FILE_NOT_FOUND?S_OK:winerr();
+    do {
+        struct local_snapshot *s=NULL;WCHAR expected[1200];
+        if(info.dwFileAttributes&(FILE_ATTRIBUTE_DIRECTORY|FILE_ATTRIBUTE_REPARSE_POINT)) {hr=E_ACCESSDENIED;break;}
+        _snwprintf(path,ARRAY_SIZE(path),L"%s\\%s",p->root,info.cFileName);
+        hr=load_path(path,&s);if(hr!=S_OK) {if(hr==S_FALSE)hr=HRESULT_FROM_WIN32(ERROR_INVALID_DATA);break;}
+        hr=container_path(p,s->name,expected);
+        if(FAILED(hr)||wcscmp(path,expected)) {free_snapshot(s);hr=HRESULT_FROM_WIN32(ERROR_INVALID_DATA);break;}
+        *tail=s;tail=&s->next;if(used)*used+=snapshot_bytes(s);
+    } while(FindNextFileW(find,&info));
+    if(SUCCEEDED(hr)&&GetLastError()!=ERROR_NO_MORE_FILES)hr=winerr();
+    FindClose(find);
+    if(FAILED(hr)){free_snapshot(*out);*out=NULL;}return hr;
+}
+static void put_bytes(BYTE **cursor,const void *data,SIZE_T size) { memcpy(*cursor,data,size);*cursor+=size; }
+static void put_string(BYTE **cursor,const char *s) { UINT32 n=strlen(s);put_bytes(cursor,&n,4);put_bytes(cursor,s,n); }
+static HRESULT persist_container(struct local_provider *p,struct local_snapshot *s)
+{
+    struct local_blob *b;UINT64 total=44+4+strlen(s->name)+4+strlen(s->display)+8+4;UINT32 count=0,payload;
+    BYTE *buffer,*cursor;WCHAR path[1200],temp[1200];HANDLE file;DWORD written;HRESULT hr;static LONG serial;
+    for(b=s->blobs;b;b=b->next) {total+=4+strlen(b->name)+4+b->size;count++;}
+    if(total>LOCAL_QUOTA+UPDATE_LIMIT)return GS_QUOTA;
+    buffer=malloc(total);if(!buffer)return E_OUTOFMEMORY;
+    memcpy(buffer,"WGDKLGS1",8);payload=total-44;memcpy(buffer+8,&payload,4);cursor=buffer+44;
+    put_string(&cursor,s->name);put_string(&cursor,s->display);put_bytes(&cursor,&s->modified,8);put_bytes(&cursor,&count,4);
+    for(b=s->blobs;b;b=b->next){put_string(&cursor,b->name);put_bytes(&cursor,&b->size,4);put_bytes(&cursor,b->data,b->size);}
+    hr=sha256(buffer+44,payload,buffer+12);if(FAILED(hr))goto done;
+    hr=container_path(p,s->name,path);if(FAILED(hr))goto done;
+    _snwprintf(temp,ARRAY_SIZE(temp),L"%s\\.tmp-%lu-%lu",p->root,GetCurrentProcessId(),InterlockedIncrement(&serial));
+    file=CreateFileW(temp,GENERIC_WRITE,0,NULL,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,NULL);
+    if(file==INVALID_HANDLE_VALUE){hr=winerr();goto done;}
+    if(!WriteFile(file,buffer,(DWORD)total,&written,NULL)||written!=total||!FlushFileBuffers(file))hr=winerr();
+    CloseHandle(file);
+    if(SUCCEEDED(hr)&&!MoveFileExW(temp,path,MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH))hr=winerr();
+    if(FAILED(hr))DeleteFileW(temp);
+done:
+    free(buffer);return hr;
+}
+static HRESULT enumerate_local(void *id,const char *prefix,const char *exact,void *context,XGameSaveContainerInfoCallback *callback)
+{
+    struct local_handle *h;struct local_snapshot *list=NULL,*s;HANDLE lock=INVALID_HANDLE_VALUE;HRESULT hr;
+    UINT32 delivered=0;
+    TRACE("Container enumeration enter filtered=%d exact=%d.\n",prefix!=NULL,exact!=NULL);
+    if(!callback)return E_POINTER;
+    AcquireSRWLockExclusive(&local_lock);
+    hr=usable_handle(id,PROVIDER_HANDLE,&h);
+    if(SUCCEEDED(hr))hr=storage_lock(h->provider,&lock);
+    if(SUCCEEDED(hr))hr=list_containers(h->provider,&list,NULL);
+    if(lock!=INVALID_HANDLE_VALUE)CloseHandle(lock);
+    ReleaseSRWLockExclusive(&local_lock);
+    if(SUCCEEDED(hr))for(s=list;s;s=s->next) {
+        XGameSaveContainerInfo info;struct local_blob *b;BOOLEAN keep_going;
+        if(prefix&&strncmp(s->name,prefix,strlen(prefix)))continue;
+        if(exact&&strcmp(s->name,exact))continue;
+        info.name=s->name;info.displayName=s->display;info.blobCount=0;info.totalSize=0;info.lastModifiedTime=s->modified;info.needsSync=FALSE;
+        for(b=s->blobs;b;b=b->next){info.blobCount++;info.totalSize+=b->size;}
+        TRACE("Container enumeration callback begin index=%u blobCount=%u.\n",delivered,info.blobCount);
+        keep_going=callback(&info,context);delivered++;
+        TRACE("Container enumeration callback returned count=%u continue=%d.\n",delivered,keep_going);
+        if(!keep_going)break;
+    }
+    TRACE("Container enumeration returned hr=%#lx count=%u.\n",hr,delivered);
+    free_snapshot(list);return hr;
+}
+static HRESULT enumerate_blobs_local(void *id,const char *prefix,void *context,XGameSaveBlobInfoCallback *callback)
+{
+    struct local_handle *h;struct local_snapshot *s=NULL;struct local_blob *b;HANDLE lock=INVALID_HANDLE_VALUE;HRESULT hr;
+    UINT32 delivered=0;
+    TRACE("Blob enumeration enter filtered=%d.\n",prefix!=NULL);
+    if(!callback)return E_POINTER;
+    AcquireSRWLockExclusive(&local_lock);hr=usable_handle(id,CONTAINER_HANDLE,&h);
+    if(SUCCEEDED(hr))hr=storage_lock(h->provider,&lock);
+    if(SUCCEEDED(hr))hr=load_container(h->provider,h->name,&s);
+    if(hr==S_FALSE)hr=S_OK;
+    if(lock!=INVALID_HANDLE_VALUE)CloseHandle(lock);ReleaseSRWLockExclusive(&local_lock);
+    if(SUCCEEDED(hr)&&s)for(b=s->blobs;b;b=b->next){
+        XGameSaveBlobInfo info={b->name,b->size};BOOLEAN keep_going;
+        if(prefix&&strncmp(b->name,prefix,strlen(prefix)))continue;
