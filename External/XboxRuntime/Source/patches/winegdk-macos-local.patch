+    selected=calloc(n?n:1,sizeof(*selected));if(!selected){hr=E_OUTOFMEMORY;goto done;}
+    if(names)for(i=0;i<n;i++){for(b=s->blobs;b;b=b->next)if(!strcmp(b->name,names[i]))break;if(!b){hr=GS_BLOB_NOT_FOUND;goto done;}selected[i]=b;}
+    else {i=0;for(b=s->blobs;b;b=b->next)selected[i++]=b;}
+    required=(SIZE_T)n*sizeof(*blobs);
+    for(i=0;i<n;i++){SIZE_T extra=strlen(selected[i]->name)+1+selected[i]->size;if(required>SIZE_MAX-extra){hr=GS_BUFFER_SMALL;goto done;}required+=extra;}
+    if(size<required){hr=GS_BUFFER_SMALL;goto done;}
+    cursor=(BYTE *)(blobs+n);
+    for(i=0;i<n;i++){SIZE_T len=strlen(selected[i]->name)+1;blobs[i].info.name=(char *)cursor;memcpy(cursor,selected[i]->name,len);cursor+=len;blobs[i].info.size=selected[i]->size;blobs[i].data=cursor;memcpy(cursor,selected[i]->data,selected[i]->size);cursor+=selected[i]->size;}
+    *count=n;hr=S_OK;
+done:
+    TRACE("ReadBlobData resultCount=%u requiredSize=%Iu hr=%#lx.\n",*count,required,hr);
+    free(selected);free_snapshot(s);return trace_result(__func__, hr);
+}
