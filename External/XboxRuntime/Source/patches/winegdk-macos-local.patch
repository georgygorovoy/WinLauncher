+    TRACE("%s returned hr=%#lx.\n", operation, hr);
+    return hr;
+}
+/* A separate local store: no native WGS files, network calls, or cloud ownership claims. */
+#define LOCAL_QUOTA (256u * 1024u * 1024u)
