+    UINT64 change_bytes;
+    BOOL consumed;
+};
+static SRWLOCK local_lock = SRWLOCK_INIT;
+static struct local_handle *local_handles;
+static ULONG_PTR next_local_id = 0x47530000;
+enum { PROVIDER_HANDLE = 1, CONTAINER_HANDLE, UPDATE_HANDLE };
+
+static HRESULT winerr(void) { DWORD e = GetLastError(); return HRESULT_FROM_WIN32(e ? e : ERROR_GEN_FAILURE); }
+static char *copy_string(const char *s) { SIZE_T n; char *p; if (!s) return NULL; n = strlen(s)+1; p = malloc(n); if (p) memcpy(p,s,n); return p; }
+static BOOL local_enabled(void) { WCHAR value[4]; return GetEnvironmentVariableW(L"WINEGDK_LOCAL_GAMESAVE",value,4)==1 && value[0]=='1'; }
+static BOOL ascii_alnum(char c) { return (c>='a'&&c<='z') || (c>='A'&&c<='Z') || (c>='0'&&c<='9'); }
+static BOOL valid_name(const char *s, BOOL container)
+{
+    SIZE_T n, last = 0, i;
+    if (!s || !(n = strnlen(s,257)) || n > 256 || s[0]=='/' || s[n-1]=='/' || s[n-1]=='.') return FALSE;
+    for (i=0;i<n;i++) {
+        if (s[i]=='.' && i && s[i-1]=='.') return FALSE;
+        if (!(ascii_alnum(s[i]) || s[i]=='_' || s[i]=='.' || s[i]=='-' || (container && s[i]=='/'))) return FALSE;
+        if (s[i]=='/') {
+            SIZE_T j;
+            if (i==last) return FALSE;
+            for (j=last;j<i;j++) if (!(ascii_alnum(s[j]) || s[j]=='_')) return FALSE;
+            last=i+1;
+        }
+    }
+    return TRUE;
+}
+static BOOL normalize_scid(const char *s, WCHAR out[37])
+{
+    unsigned int i;
+    if (!s || strnlen(s,37)!=36) return FALSE;
+    for(i=0;i<36;i++) {
+        char c=s[i];
+        if(i==8||i==13||i==18||i==23) { if(c!='-') return FALSE; }
+        else { if(c>='A'&&c<='F') c+=32; if(!((c>='0'&&c<='9')||(c>='a'&&c<='f'))) return FALSE; }
