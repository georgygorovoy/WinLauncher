+
+static HRESULT WINAPI game_save_FilesGetFolderWithUiAsync(IXGameSaveImpl *iface, XUserHandle user, const char *scid, XAsyncBlock *async)
+{
+    TRACE("%s enter.\n", __func__);
+    TRACE("%s unsupported; scheduling E_NOTIMPL.\n", __func__);
+    return trace_result(__func__, begin_failure(async));
+}
+
+static HRESULT WINAPI game_save_FilesGetFolderWithUiResult(IXGameSaveImpl *iface, XAsyncBlock *async, SIZE_T size, char *folder)
+{
+    TRACE("%s enter.\n", __func__);
+    if (size && !folder) return trace_result(__func__, E_POINTER);
+    if (size) folder[0] = 0;
+    return trace_result(__func__, failure_result(async));
+}
+
+static HRESULT WINAPI game_save_FilesGetRemainingQuota(IXGameSaveImpl *iface, XUserHandle user, const char *scid, INT64 *quota)
+{
+    TRACE("%s enter.\n", __func__);
+    if (!quota) return trace_result(__func__, E_POINTER);
+    *quota = 0;
+    return trace_result(__func__, E_NOTIMPL);
+}
