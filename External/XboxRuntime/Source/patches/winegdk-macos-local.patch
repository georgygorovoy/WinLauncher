+    hr=QueryApiImpl(&CLSID_XUserImpl,&IID_IXUserImpl,(void **)&c->users);
+    if(SUCCEEDED(hr)&&!c->users)hr=E_UNEXPECTED;
+    if(SUCCEEDED(hr))hr=IXUserImpl_XUserDuplicateHandle(c->users,user,&c->user);
+    if(SUCCEEDED(hr))hr=QueryApiImpl(&CLSID_XThreadingImpl,&IID_IXThreadingImpl,(void **)&c->threading);
+    if(SUCCEEDED(hr)&&!c->threading)hr=E_UNEXPECTED;
+    if(SUCCEEDED(hr))hr=IXThreadingImpl_XAsyncBegin(c->threading,async,c,&local_identity,"LocalGameSaveInitialize",local_init_provider);
+    if(FAILED(hr))free_init_context(c);
