+    if(SUCCEEDED(hr)){b->name=copy_string(name);b->data=malloc(size?size:1);if(!b->name||!b->data)hr=E_OUTOFMEMORY;}
+    if(SUCCEEDED(hr)){if(size)memcpy(b->data,data,size);b->size=size;b->next=h->changes;h->changes=b;h->change_bytes+=size;b=NULL;}
