+    attrs=GetFileAttributesW(p);
+    if(attrs==INVALID_FILE_ATTRIBUTES) return winerr();
+    if(!(attrs&FILE_ATTRIBUTE_DIRECTORY) || (attrs&FILE_ATTRIBUTE_REPARSE_POINT)) return E_ACCESSDENIED;
+    return S_OK;
+}
+static HRESULT append_dir(WCHAR *path, SIZE_T count, const WCHAR *part)
+{
+    SIZE_T n=wcslen(path), m=wcslen(part);
+    if(n+m+2>count) return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    path[n++]='\\'; memcpy(path+n,part,(m+1)*sizeof(WCHAR)); return make_dir(path);
+}
+static void release_provider(struct local_provider *p)
+{
+    if (!--p->refs) { IXUserImpl_XUserCloseHandle(p->users,p->user); IXUserImpl_Release(p->users); free(p); }
+}
+static void free_blobs(struct local_blob *b)
+{
+    while(b) { struct local_blob *next=b->next; free(b->name); free(b->data); free(b); b=next; }
+}
+static void free_snapshot(struct local_snapshot *s)
+{
+    while(s) { struct local_snapshot *next=s->next; free(s->name); free(s->display); free_blobs(s->blobs); free(s); s=next; }
+}
+static struct local_handle *find_handle(void *id, unsigned int kind)
+{
+    struct local_handle *h;
+    for(h=local_handles;h;h=h->next) if(h->id==(ULONG_PTR)id && h->kind==kind) return h;
+    return NULL;
+}
+static HRESULT usable_handle(void *id,unsigned int kind,struct local_handle **out)
+{
+    *out=find_handle(id,kind);
+    return !*out || (*out)->provider->closed ? E_HANDLE : S_OK;
+}
+static HRESULT new_handle(unsigned int kind,struct local_provider *p,const char *name,const char *display,void **out)
+{
+    struct local_handle *h=calloc(1,sizeof(*h));
+    if(!h) return E_OUTOFMEMORY;
+    if((name && !(h->name=copy_string(name))) || (display && !(h->display=copy_string(display)))) { free(h->name);free(h->display);free(h);return E_OUTOFMEMORY; }
+    if(next_local_id==(ULONG_PTR)-1) { free(h->name);free(h->display);free(h);return E_OUTOFMEMORY; }
+    h->id=++next_local_id;h->kind=kind;h->provider=p;p->refs++;
