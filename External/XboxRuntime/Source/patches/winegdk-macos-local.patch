+#define GS_UPDATE_BIG ((HRESULT)0x80830005)
+
+struct local_provider { LONG refs; BOOL closed; WCHAR root[1024]; IXUserImpl *users; XUserHandle user; };
+struct local_blob { struct local_blob *next; char *name; BYTE *data; UINT32 size; BOOL deleted; };
+struct local_snapshot { struct local_snapshot *next; char *name, *display; INT64 modified; struct local_blob *blobs; };
+struct local_handle {
+    struct local_handle *next;
+    ULONG_PTR id;
+    unsigned int kind;
+    struct local_provider *provider;
+    char *name, *display;
