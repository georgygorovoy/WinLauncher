+/* XAsync owns the threading reference after Begin accepts the operation. */
+static HRESULT WINAPI failure_provider(XAsyncOp op, const XAsyncProviderData *data)
+{
+    IXThreadingImpl *threading = data->context;
+    TRACE("failure provider op=%u.\n", op);
+    switch (op)
+    {
+    case XAsyncOp_Begin:
+        return IXThreadingImpl_XAsyncSchedule(threading, data->async, 0);
+    case XAsyncOp_DoWork:
+        IXThreadingImpl_XAsyncComplete(threading, data->async, E_NOTIMPL, 0);
+        return E_PENDING;
+    case XAsyncOp_GetResult:
+        return E_NOTIMPL;
+    case XAsyncOp_Cleanup:
+        IXThreadingImpl_Release(threading);
+        return S_OK;
+    case XAsyncOp_Cancel:
+        return S_OK;
+    }
+    return E_NOTIMPL;
+}
+
+static HRESULT begin_failure(XAsyncBlock *async)
+{
+    IXThreadingImpl *threading = NULL;
+    HRESULT hr;
+    if (!async) return E_INVALIDARG;
+    hr = QueryApiImpl(&CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&threading);
+    if (FAILED(hr)) return hr;
+    if (!threading) return E_UNEXPECTED;
+    hr = IXThreadingImpl_XAsyncBegin(threading, async, threading, &failure_identity,
+                                   "GameSaveUnsupported", failure_provider);
+    if (FAILED(hr)) IXThreadingImpl_Release(threading);
+    TRACE("XAsyncBegin returned %#lx.\n", hr);
+    return hr;
+}
+
+static HRESULT failure_result(XAsyncBlock *async)
+{
+    IXThreadingImpl *threading = NULL;
+    HRESULT hr;
+    if (!async) return E_INVALIDARG;
+    hr = QueryApiImpl(&CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&threading);
+    if (FAILED(hr)) return hr;
+    if (!threading) return E_UNEXPECTED;
+    hr = IXThreadingImpl_XAsyncGetResult(threading, async, &failure_identity, 0, NULL, NULL);
+    IXThreadingImpl_Release(threading);
+    TRACE("XAsyncGetResult returned %#lx.\n", hr);
+    /* No block, including a foreign successful operation, can produce a provider here. */
+    return SUCCEEDED(hr) ? E_UNEXPECTED : hr;
+}
