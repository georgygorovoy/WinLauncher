+struct local_init_context { IXThreadingImpl *threading; IXUserImpl *users; XUserHandle user; char *scid; XGameSaveProviderHandle provider; };
+static const char local_identity;
+static void free_init_context(struct local_init_context *c)
+{
+    if(c->provider)close_local(c->provider,PROVIDER_HANDLE);
+    if(c->user)IXUserImpl_XUserCloseHandle(c->users,c->user);
+    if(c->users)IXUserImpl_Release(c->users);
+    if(c->threading)IXThreadingImpl_Release(c->threading);
+    free(c->scid);free(c);
+}
+static HRESULT WINAPI local_init_provider(XAsyncOp op,const XAsyncProviderData *data)
+{
+    struct local_init_context *c=data->context;HRESULT hr;
+    switch(op) {
+    case XAsyncOp_Begin:return IXThreadingImpl_XAsyncSchedule(c->threading,data->async,0);
+    case XAsyncOp_DoWork:
+        hr=create_local_provider(c->user,c->scid,&c->provider);
+        IXThreadingImpl_XAsyncComplete(c->threading,data->async,hr,SUCCEEDED(hr)?sizeof(c->provider):0);
+        return E_PENDING;
+    case XAsyncOp_GetResult:
+        if(data->bufferSize<sizeof(c->provider)||!data->buffer||!c->provider)return E_UNEXPECTED;
+        memcpy(data->buffer,&c->provider,sizeof(c->provider));c->provider=NULL;return S_OK;
+    case XAsyncOp_Cleanup:free_init_context(c);return S_OK;
+    case XAsyncOp_Cancel:return S_OK;
+    }
+    return E_NOTIMPL;
+}
+static HRESULT begin_local(XUserHandle user,const char *scid,XAsyncBlock *async)
+{
