+/* Store calls own their connection: no shared callback or response matching state. */
+#include "store.h"
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <time.h>
+
+static long long store_now_ms(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (long long)t.tv_sec * 1000 + t.tv_nsec / 1000000;
+}
+static NTSTATUS store_wait(int fd, short events, long long deadline)
+{
+    struct pollfd p = {fd, events, 0};
+    int n;
+    long long left;
+    for (;;) {
+        left = deadline - store_now_ms();
+        if (left <= 0) return STATUS_IO_TIMEOUT;
+        n = poll(&p, 1, (int)left);
+        if (n < 0 && errno == EINTR) continue;
+        if (!n) return STATUS_IO_TIMEOUT;
+        if (n < 0 || !(p.revents & events)) return STATUS_CONNECTION_DISCONNECTED;
+        return STATUS_SUCCESS;
+    }
+}
+static NTSTATUS store_transfer(int fd, BYTE *data, size_t count, BOOL writing, long long deadline)
+{
+    NTSTATUS status;
+    ssize_t n;
+    while (count) {
+        status = store_wait(fd, writing ? POLLOUT : POLLIN, deadline);
+        if (status) return status;
+        n = writing ? write(fd, data, count) : read(fd, data, count);
+        if (n < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) continue;
+        if (n <= 0) return STATUS_CONNECTION_DISCONNECTED;
+        data += n; count -= n;
+    }
+    return STATUS_SUCCESS;
+}
+static NTSTATUS store_request(void *args)
+{
+    struct store_unix_request *a = args;
+    struct sockaddr_un address;
+    struct stat st;
+    BYTE header[8];
