diff --git a/dlls/xgameruntime/GDKComponent/System/HttpStatusTrace.h b/dlls/xgameruntime/GDKComponent/System/HttpStatusTrace.h
new file mode 100644
index 0000000..eebccb1
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/HttpStatusTrace.h
@@ -0,0 +1,181 @@
+/* Opt-in, process-local HTTP outcome diagnostics. No general HC tracing. */
+#ifndef WINEGDK_HTTP_STATUS_TRACE_H
+#define WINEGDK_HTTP_STATUS_TRACE_H
+
+typedef void (WINAPI *status_routed_callback)( void *, void * );
+
+static struct
+{
+    SRWLOCK lock;
+    BOOL registered;
+    HRESULT (WINAPI *get_url)( void *, const char **, const char ** );
+    HRESULT (WINAPI *get_status)( void *, UINT32 * );
+    HRESULT (WINAPI *get_error)( void *, HRESULT *, UINT32 * );
+    UINT64 (WINAPI *get_id)( void * );
+    HRESULT (WINAPI *get_body_size)( void *, SIZE_T * );
+    HRESULT (WINAPI *get_body)( void *, SIZE_T, BYTE *, SIZE_T * );
+} http_status_trace;
+
+static const char *http_status_safe_method( const char *method )
+{
+    static const char *const allowed[] = { "GET", "POST", "PUT", "DELETE", "HEAD", "PATCH", "OPTIONS", "CONNECT", "TRACE" };
+    SIZE_T i;
+
+    if (method)
+        for (i = 0; i < ARRAY_SIZE(allowed); ++i)
+            if (!strcmp( method, allowed[i] )) return allowed[i];
+    return "OTHER";
+}
+
+/* Copy only a validated DNS hostname. Never fall back to the supplied URL. */
+static void http_status_safe_host( const char *url, char host[254] )
+{
+    const char *start, *end, *p, *at = NULL;
+    SIZE_T length;
+
+    strcpy( host, "unknown" );
+    if (!url) return;
+    if (!strncmp( url, "https://", 8 )) start = url + 8;
+    else if (!strncmp( url, "http://", 7 )) start = url + 7;
+    else return;
+    for (end = start; *end && *end != '/' && *end != '?' && *end != '#'; ++end)
+        if (*end == '@') at = end;
+    if (at) start = at + 1;
+    /* IPv6 literals and unfamiliar authority syntax are intentionally omitted. */
+    for (p = start; p < end; ++p)
+        if (*p == ':')
+        {
+            const char *port;
+            if (p + 1 == end) return;
+            for (port = p + 1; port < end; ++port)
+                if (*port < '0' || *port > '9') return;
+            end = p;
+            break;
+        }
+    length = end - start;
+    if (!length || length >= 254) return;
+    for (p = start; p < end; ++p)
+        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+                (*p >= '0' && *p <= '9') || *p == '.' || *p == '-')) return;
+    memcpy( host, start, length );
+    host[length] = 0;
+}
+
+static BOOL http_status_ascii_word( BYTE value )
+{
+    return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') ||
+            (value >= '0' && value <= '9') || value == '_';
+}
+
+/* These are mention flags, not diagnoses. Requiring a word start avoids e.g.
+ * treating "entitlement" as a title mention; suffixes such as TitleId match.
+ * Work only within the returned byte count, never assume a terminating NUL. */
+static BOOL http_status_mentions( const BYTE *bytes, SIZE_T size, const char *word )
+{
+    SIZE_T length = strlen( word ), i, j;
+
+    if (size < length) return FALSE;
+    for (i = 0; i <= size - length; ++i)
+    {
+        if (i && http_status_ascii_word( bytes[i - 1] )) continue;
+        for (j = 0; j < length; ++j)
+        {
+            BYTE value = bytes[i + j];
+            if (value >= 'A' && value <= 'Z') value += 'a' - 'A';
+            if (value != (BYTE)word[j]) break;
+        }
+        if (j == length) return TRUE;
+    }
+    return FALSE;
+}
+
+static void http_status_presence_error( void *call, UINT64 id )
+{
+    BYTE bytes[4096];
+    SIZE_T size = 0, used = 0;
+    HRESULT hr = E_NOTIMPL;
+    const char *inspection = "unavailable";
+    BOOL sandbox = FALSE, title = FALSE, device = FALSE;
+
+    if (!http_status_trace.get_body_size || !http_status_trace.get_body) goto report;
+    if (FAILED(hr = http_status_trace.get_body_size( call, &size ))) goto report;
+    if (!size) { inspection = "empty"; goto report; }
+    if (size > sizeof(bytes)) { inspection = "over_limit"; goto report; }
+    hr = http_status_trace.get_body( call, sizeof(bytes), bytes, &used );
+    if (SUCCEEDED(hr) && used == size && used <= sizeof(bytes))
+    {
+        inspection = "scanned";
+        sandbox = http_status_mentions( bytes, used, "sandbox" );
+        title = http_status_mentions( bytes, used, "title" );
+        device = http_status_mentions( bytes, used, "device" );
+    }
+    else inspection = "read_failed";
+    SecureZeroMemory( bytes, sizeof(bytes) );
+report:
+    /* No free-form server text, body, header, or string-valued error code. */
+    TRACE( "Presence400 id=%llu classification=unresolved inspection=%s sandboxMention=%d titleMention=%d deviceMention=%d getter=%#lx.\n",
+            id, inspection, sandbox, title, device, hr );
+}
+
+static void WINAPI http_status_routed( void *call, void *context )
+{
+    const char *method = NULL, *url = NULL;
+    UINT32 status = 0, platform_error = 0;
+    HRESULT status_hr, error_hr, network_error = E_PENDING;
+    char host[254];
+    UINT64 id;
+
+    /* The borrowed call/strings are used only synchronously in this callback. */
+    status_hr = http_status_trace.get_status( call, &status );
+    error_hr = http_status_trace.get_error( call, &network_error, &platform_error );
+    if (FAILED(http_status_trace.get_url( call, &method, &url ))) method = url = NULL;
+    http_status_safe_host( url, host );
+    id = http_status_trace.get_id( call );
+    TRACE( "HTTP outcome id=%llu method=%s host=%s status=%u network=%#lx platform=%u statusGetter=%#lx errorGetter=%#lx.\n",
+            id, http_status_safe_method( method ), host, status, network_error,
+            platform_error, status_hr, error_hr );
+    if (SUCCEEDED(status_hr) && status == 400 && method && !strcmp( method, "POST" ) &&
+            !strcmp( host, "userpresence.xboxlive.com" ))
+        http_status_presence_error( call, id );
+}
+
+/* Call from normal runtime API code, never DllMain. No HCInitialize or cleanup:
+ * ownership of the native client's initialization remains with the game.
+ * The opt-in observer and its code remain valid for this process lifetime. */
+static void enable_http_status_trace( void )
+{
+    BOOLEAN (WINAPI *is_initialized)( void );
+    INT32 (WINAPI *add_handler)( status_routed_callback, void * );
+    HMODULE module, pinned;
+    WCHAR enabled[2];
+    INT32 handler;
+
+    if (GetEnvironmentVariableW( L"WINEGDK_HTTP_STATUS_TRACE", enabled, ARRAY_SIZE(enabled) ) != 1 ||
+            enabled[0] != '1') return;
+    AcquireSRWLockExclusive( &http_status_trace.lock );
+    if (http_status_trace.registered) goto done;
+    /* Observe only the DLL already loaded by the game. */
+    if (!GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_PIN,
+            L"libHttpClient.GDK.dll", &module )) goto done;
+    is_initialized = (void *)GetProcAddress( module, "HCIsInitialized" );
+    add_handler = (void *)GetProcAddress( module, "HCAddCallRoutedHandler" );
+    http_status_trace.get_url = (void *)GetProcAddress( module, "HCHttpCallRequestGetUrl" );
+    http_status_trace.get_status = (void *)GetProcAddress( module, "HCHttpCallResponseGetStatusCode" );
+    http_status_trace.get_error = (void *)GetProcAddress( module, "HCHttpCallResponseGetNetworkErrorCode" );
+    http_status_trace.get_id = (void *)GetProcAddress( module, "HCHttpCallGetId" );
+    http_status_trace.get_body_size = (void *)GetProcAddress( module, "HCHttpCallResponseGetResponseBodyBytesSize" );
+    http_status_trace.get_body = (void *)GetProcAddress( module, "HCHttpCallResponseGetResponseBodyBytes" );
+    if (!is_initialized || !add_handler || !http_status_trace.get_url ||
+            !http_status_trace.get_status || !http_status_trace.get_error ||
+            !http_status_trace.get_id || !is_initialized()) goto done;
+    /* Prevent a dangling callback/getter if either DLL is explicitly unloaded. */
+    if (!GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+            (LPCWSTR)http_status_routed, &pinned )) goto done;
+    handler = add_handler( http_status_routed, NULL );
+    if (handler >= 0) http_status_trace.registered = TRUE;
+    TRACE( "HTTP status observer registration result=%ld.\n", handler );
+done:
+    ReleaseSRWLockExclusive( &http_status_trace.lock );
+}
+
+#endif
diff --git a/dlls/xgameruntime/GDKComponent/System/XStore.c b/dlls/xgameruntime/GDKComponent/System/XStore.c
new file mode 100644
index 0000000..836c772
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/XStore.c
@@ -0,0 +1,392 @@
+#define COBJMACROS
+#include "XStore.h"
+#include <winternl.h>
+#include "../Xodus/Unix/store.h"
+#include "wine/unixlib.h"
+#include "wine/debug.h"
+#include <libxml/parser.h>
+#include <libxml/chvalid.h>
+#include <stdlib.h>
+#include <string.h>
+
+WINE_DEFAULT_DEBUG_CHANNEL(xstore);
+extern unixlib_handle_t unixhandle;
+extern HRESULT WINAPI QueryApiImpl(const GUID *, REFIID, void **);
+char gdkStoreId[13];
+static const char token_identity, products_identity, collections_identity, purchase_identity, associated_identity;
+struct store_context { struct store_context *next; ULONG_PTR id; LONG refs; char binding[37], parent[13]; };
+static SRWLOCK context_lock = SRWLOCK_INIT;
+static struct store_context *contexts;
+static ULONG_PTR next_context = 0x53540000;
+static LONG interface_refs = 1;
+struct token_operation {
+    struct store_context *context;
+    IXThreadingImpl *threading;
+    char **products, *challenge, *token;
+    SIZE_T count, token_size;
+    BOOL request_token;
+};
+static BOOL valid_id(const char *s)
+{
+    SIZE_T i;
+    if (!s || strnlen(s,13)!=12) return FALSE;
+    for(i=0;i<12;i++) if (!((s[i]>='0'&&s[i]<='9')||(s[i]>='A'&&s[i]<='Z')||(s[i]>='a'&&s[i]<='z'))) return FALSE;
+    return TRUE;
+}
+static BOOL valid_binding(const char *s)
+{
+    unsigned int i;
+    if(!s || strnlen(s,37)!=36) return FALSE;
+    for(i=0;i<36;i++) {
+        if(i==8||i==13||i==18||i==23) { if(s[i]!='-') return FALSE; }
+        else if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')||(s[i]>='A'&&s[i]<='F'))) return FALSE;
+    }
+    return TRUE;
+}
+static char *copy_string(const char *s)
+{
+    SIZE_T n=strlen(s)+1; char *p=malloc(n); if(p) memcpy(p,s,n); return p;
+}
+static BOOL valid_challenge(const char *s)
+{
+    SIZE_T n, i=0; unsigned int cp, bytes, j;
+    if(!s || !(n=strnlen(s,4097)) || n>4096 || !xmlCheckUTF8((const xmlChar *)s)) return FALSE;
+    while(i<n) {
+        unsigned char c=s[i++];
+        if(c<0x80) { cp=c; bytes=0; }
+        else if(c<0xe0) { cp=c&0x1f; bytes=1; }
+        else if(c<0xf0) { cp=c&0xf; bytes=2; }
+        else { cp=c&7; bytes=3; }
+        if(i+bytes>n) return FALSE;
+        for(j=0;j<bytes;j++) cp=(cp<<6)|((unsigned char)s[i++]&0x3f);
+        if(!xmlIsChar(cp)) return FALSE;
+    }
+    return TRUE;
+}
+static void release_context(struct store_context *c)
+{
+    if(c && !InterlockedDecrement(&c->refs)) free(c);
+}
+static struct store_context *retain_context(XStoreContextHandle handle)
+{
+    struct store_context *c;
+    AcquireSRWLockShared(&context_lock);
+    for(c=contexts;c;c=c->next) if(c->id==(ULONG_PTR)handle) { InterlockedIncrement(&c->refs); break; }
+    ReleaseSRWLockShared(&context_lock); return c;
+}
+static HRESULT parse_hresult(const xmlChar *s, HRESULT *out)
+{
+    UINT64 n=0; unsigned int i;
+    if(!s || !s[0]) return E_INVALIDARG;
+    for(i=0;s[i];i++) { if(i>=10 || s[i]<'0'||s[i]>'9') return E_INVALIDARG; n=n*10+s[i]-'0'; if(n>0xffffffffu) return E_INVALIDARG; }
+    *out=(HRESULT)(UINT32)n; return S_OK;
+}
+/* Text only: no entities, nested elements, attributes, namespaces, or DTDs. */
+static BOOL plain_element(xmlNodePtr n)
+{
+    xmlNodePtr c;
+    if(n->properties || n->ns) return FALSE;
+    for(c=n->children;c;c=c->next) if(c->type!=XML_TEXT_NODE) return FALSE;
+    return TRUE;
+}
+static HRESULT exchange_xml(xmlDocPtr request, UINT16 type, const char *root_name, const char *value_name, SIZE_T value_limit, char **out)
+{
+    struct store_unix_request a;
+    xmlChar *encoded=NULL, *value=NULL, *hr_text=NULL;
+    xmlDocPtr response=NULL;
+    xmlNodePtr root,n;
+    int encoded_size=0;
+    LONG status;
+    HRESULT hr=E_INVALIDARG, server_hr=E_FAIL;
+    BOOL seen_hr=FALSE, seen_value=FALSE;
+    *out=NULL; memset(&a,0,sizeof(a));
+    xmlDocDumpMemoryEnc(request,&encoded,&encoded_size,"UTF-8");
+    if(!encoded) return E_OUTOFMEMORY;
+    if(encoded_size<=0 || encoded_size>8192) goto done;
+    a.request=encoded; a.request_size=encoded_size; a.request_type=type; a.response_type=type+1;
+    a.response_capacity=type==5?1024:65535;
+    if(!(a.response=malloc(a.response_capacity))) { hr=E_OUTOFMEMORY; goto done; }
+    if(!unixhandle) { hr=HRESULT_FROM_WIN32(ERROR_SERVICE_NOT_ACTIVE); goto done; }
+    status=__wine_unix_call(unixhandle,STORE_UNIX_REQUEST,&a);
+    if(status) { hr=HRESULT_FROM_WIN32(RtlNtStatusToDosError(status)); goto done; }
+    /* Existing framing allows one final NUL, never embedded NULs. */
+    if(a.response_size && !a.response[a.response_size-1]) a.response_size--;
+    if(!a.response_size || memchr(a.response,0,a.response_size)) goto done;
+    response=xmlReadMemory((const char *)a.response,a.response_size,NULL,"UTF-8",XML_PARSE_NONET|XML_PARSE_NOERROR|XML_PARSE_NOWARNING);
+    if(!response || response->intSubset || response->extSubset) goto done;
+    root=xmlDocGetRootElement(response);
+    if(!root || root->properties || root->ns || xmlStrcmp(root->name,(const xmlChar *)root_name)) goto done;
+    for(n=root->children;n;n=n->next) {
+        if(n->type==XML_TEXT_NODE && xmlIsBlankNode(n)) continue;
+        if(n->type!=XML_ELEMENT_NODE || !plain_element(n)) goto done;
+        if(!xmlStrcmp(n->name,(const xmlChar *)"HResult")) {
+            if(seen_hr) goto done; seen_hr=TRUE; hr_text=xmlNodeGetContent(n);
+        } else if(!xmlStrcmp(n->name,(const xmlChar *)value_name)) {
+            if(seen_value) goto done; seen_value=TRUE; value=xmlNodeGetContent(n);
+        } else goto done;
+    }
+    if(!seen_hr || FAILED(parse_hresult(hr_text,&server_hr))) goto done;
+    if(FAILED(server_hr)) { hr=server_hr; goto done; }
+    if(server_hr!=S_OK || !seen_value || !value || !value[0] || strnlen((char *)value,value_limit+1)>value_limit) goto done;
+    if(type==5 && !valid_binding((char *)value)) goto done;
+    *out=copy_string((char *)value); hr=*out?S_OK:E_OUTOFMEMORY;
+done:
+    if(a.response) { SecureZeroMemory(a.response,a.response_capacity); free(a.response); }
+    if(value) { SecureZeroMemory(value,xmlStrlen(value)); xmlFree(value); }
+    xmlFree(hr_text); if(response) xmlFreeDoc(response);
+    if(encoded) { SecureZeroMemory(encoded,encoded_size); xmlFree(encoded); }
+    return hr;
+}
+static BOOL add_text(xmlNodePtr parent,const char *name,const char *text)
+{
+    /* xmlNewTextChild treats content as literal text, including ampersands. */
+    return xmlNewTextChild(parent,NULL,(const xmlChar *)name,(const xmlChar *)text)!=NULL;
+}
+static HRESULT request_binding(char **binding)
+{
+    xmlDocPtr doc=xmlNewDoc((const xmlChar *)"1.0");
+    xmlNodePtr root;
+    HRESULT hr;
+    *binding=NULL;
+    if(!doc) return E_OUTOFMEMORY;
+    root=xmlNewNode(NULL,(const xmlChar *)"StoreContextRequest");
+    if(!root) { xmlFreeDoc(doc); return E_OUTOFMEMORY; }
+    xmlDocSetRootElement(doc,root);
+    hr=exchange_xml(doc,5,"StoreContextResponse","AccountBinding",36,binding);
+    xmlFreeDoc(doc); return hr;
+}
+static HRESULT request_token(struct token_operation *op)
+{
+    xmlDocPtr doc=xmlNewDoc((const xmlChar *)"1.0");
+    xmlNodePtr root;
+    HRESULT hr=E_OUTOFMEMORY;
+    SIZE_T i;
+    if(!doc) return hr;
+    root=xmlNewNode(NULL,(const xmlChar *)"LicenseTokenRequest");
+    if(!root) goto done;
+    xmlDocSetRootElement(doc,root);
+    if(!add_text(root,"AccountBinding",op->context->binding)||!add_text(root,"ParentProductId",op->context->parent)) goto done;
+    for(i=0;i<op->count;i++) if(!add_text(root,"ProductId",op->products[i])) goto done;
+    if(!add_text(root,"CustomDeveloperString",op->challenge)) goto done;
+    hr=exchange_xml(doc,7,"LicenseTokenResponse","Token",48*1024,&op->token);
+    if(SUCCEEDED(hr)) op->token_size=strlen(op->token)+1;
+done:
+    xmlFreeDoc(doc); return hr;
+}
+static void free_operation(struct token_operation *op)
+{
+    SIZE_T i;
+    if(!op) return;
+    if(op->products) { for(i=0;i<op->count;i++) free(op->products[i]); free(op->products); }
+    if(op->challenge) { SecureZeroMemory(op->challenge,strlen(op->challenge)); free(op->challenge); }
+    if(op->token) { SecureZeroMemory(op->token,op->token_size); free(op->token); }
+    release_context(op->context);
+    if(op->threading) IXThreadingImpl_Release(op->threading);
+    free(op);
+}
+static HRESULT WINAPI store_provider(XAsyncOp action,const XAsyncProviderData *data)
+{
+    struct token_operation *op=data->context;
+    HRESULT hr;
+    switch(action) {
+    case XAsyncOp_Begin: return IXThreadingImpl_XAsyncSchedule(op->threading,data->async,0);
+    case XAsyncOp_DoWork:
+        hr=op->request_token?request_token(op):E_NOTIMPL;
+        TRACE("Store operation completed hr=%#lx, token_request=%u.\n",hr,op->request_token);
+        IXThreadingImpl_XAsyncComplete(op->threading,data->async,hr,SUCCEEDED(hr)?op->token_size:0);
+        return E_PENDING;
+    case XAsyncOp_GetResult:
+        if(!op->token) return E_NOTIMPL;
+        if(!data->buffer || data->bufferSize<op->token_size) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+        memcpy(data->buffer,op->token,op->token_size); return S_OK;
+    case XAsyncOp_Cancel: return S_OK; /* Accepted bounded requests finish; no fabricated cancellation. */
+    case XAsyncOp_Cleanup: free_operation(op); return S_OK;
+    default: return E_UNEXPECTED;
+    }
