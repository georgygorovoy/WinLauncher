--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/XUserRealms.h
@@ -0,0 +1,28 @@
+/* Realms uses its original XSTS audience after moving the HTTPS API host.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef __WINE_XUSER_REALMS_H
+#define __WINE_XUSER_REALMS_H
+
+static const char *xuser_realms_relying_party( const URL_COMPONENTSA *url )
+{
+    static const char *const hosts[] = {
+        "pocket.realms.minecraft.net",
+        "bedrock.frontend.realms.minecraft-services.net",
+        "bedrock.frontendlegacy.realms.minecraft-services.net"
+    };
+    SIZE_T i;
+
+    if (!url || url->nScheme != INTERNET_SCHEME_HTTPS ||
+            url->nPort != INTERNET_DEFAULT_HTTPS_PORT || !url->lpszHostName) return NULL;
+
+    /* Use the parsed host and exact length: never match a URL substring or a
+     * wildcard suffix, which could select this audience for another service. */
+    for (i = 0; i < sizeof(hosts) / sizeof(hosts[0]); ++i)
+        if (url->dwHostNameLength == strlen( hosts[i] ) &&
+                !_strnicmp( url->lpszHostName, hosts[i], url->dwHostNameLength ))
+            return "https://pocket.realms.minecraft.net/";
+    return NULL;
+}
+
+#endif
