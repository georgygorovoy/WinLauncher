+++ b/dlls/xgameruntime/GDKComponent/System/XUserClaims.h
@@ -0,0 +1,93 @@
+/* Parse only authenticated Xbox display claims. Missing/invalid claims never grant access. */
+#ifndef WINEGDK_XUSER_CLAIMS_H
+#define WINEGDK_XUSER_CLAIMS_H
+
+static BOOL xuser_claim_space( WCHAR ch )
+{
+    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n';
+}
+
+static BOOL xuser_parse_privilege_claim( const WCHAR *text, SIZE_T length,
+        UINT32 privilege, BOOLEAN *allowed )
+{
+    SIZE_T pos = 0;
+    BOOL found = FALSE;
+
+    *allowed = FALSE;
+    if (!text) return FALSE;
+    while (pos < length)
+    {
+        UINT32 value = 0;
+        while (pos < length && xuser_claim_space( text[pos] )) ++pos;
+        if (pos == length) break;
+        if (text[pos] < '0' || text[pos] > '9') return FALSE;
+        do
+        {
+            UINT32 digit = text[pos++] - '0';
+            if (value > (0xffffffffu - digit) / 10) return FALSE;
+            value = value * 10 + digit;
+        } while (pos < length && text[pos] >= '0' && text[pos] <= '9');
+        if (pos < length && !xuser_claim_space( text[pos] )) return FALSE;
+        if (value == privilege) found = TRUE;
+    }
+    *allowed = found;
+    return TRUE;
+}
+
+/* XSTS NotAfter uses ISO-8601 UTC, with an optional fractional second. */
+static BOOL xuser_parse_claim_expiry( const WCHAR *text, SIZE_T length, ULONGLONG *expiry )
+{
+    static const unsigned int starts[] = {0, 5, 8, 11, 14, 17};
+    static const unsigned int widths[] = {4, 2, 2, 2, 2, 2};
+    WORD values[6];
+    SYSTEMTIME system = {0}, check;
+    FILETIME file;
+    SIZE_T pos = 19;
+    ULONGLONG ticks, fraction = 0, scale = 1000000;
+    unsigned int i, j;
+
+    *expiry = 0;
+    if (!text || length < 20 || text[4] != '-' || text[7] != '-' ||
+        text[10] != 'T' || text[13] != ':' || text[16] != ':') return FALSE;
+    for (i = 0; i < ARRAY_SIZE(starts); ++i)
+    {
+        values[i] = 0;
+        for (j = 0; j < widths[i]; ++j)
+        {
+            WCHAR ch = text[starts[i] + j];
+            if (ch < '0' || ch > '9') return FALSE;
+            values[i] = values[i] * 10 + ch - '0';
+        }
+    }
+    if (pos < length && text[pos] == '.')
+    {
+        ++pos;
+        if (pos == length || text[pos] < '0' || text[pos] > '9') return FALSE;
+        while (pos < length && text[pos] >= '0' && text[pos] <= '9')
+        {
+            if (!scale) return FALSE; /* Precision beyond FILETIME is unsupported. */
+            fraction += (text[pos++] - '0') * scale;
+            scale /= 10;
+        }
+    }
+    if (pos + 1 != length || text[pos] != 'Z') return FALSE;
+    system.wYear = values[0]; system.wMonth = values[1]; system.wDay = values[2];
+    system.wHour = values[3]; system.wMinute = values[4]; system.wSecond = values[5];
+    if (!SystemTimeToFileTime( &system, &file ) || !FileTimeToSystemTime( &file, &check )) return FALSE;
+    if (check.wYear != system.wYear || check.wMonth != system.wMonth || check.wDay != system.wDay ||
+        check.wHour != system.wHour || check.wMinute != system.wMinute || check.wSecond != system.wSecond)
+        return FALSE;
+    ticks = ((ULONGLONG)file.dwHighDateTime << 32) | file.dwLowDateTime;
+    *expiry = ticks + fraction;
+    return TRUE;
+}
+
+static HRESULT xuser_check_privilege_claim( BOOL known, const WCHAR *text, SIZE_T length,
+        ULONGLONG expiry, ULONGLONG now, UINT32 privilege, BOOLEAN *allowed )
+{
+    *allowed = FALSE;
+    if (!known || !expiry || expiry <= now) return E_NOTIMPL;
+    if (!xuser_parse_privilege_claim( text, length, privilege, allowed )) return E_NOTIMPL;
+    return S_OK;
+}
+#endif
