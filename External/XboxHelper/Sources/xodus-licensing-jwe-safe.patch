+fn compact_token(response: soap::RequestSecurityTokenResponse) -> Result<String, String> {
+    let value = response.requested_security_token.binary_security_token
+        .ok_or_else(|| "Microsoft ticket payload is missing".to_string())?
+        .value;
+    match response.token_type.as_str() {
+        "urn:passport:compact" => Ok(value),
+        "urn:passport:delegationcompact" => Ok(format!("d={value}")),
+        _ => Err("Microsoft returned an unsupported ticket type".to_string()),
+    }
+}
