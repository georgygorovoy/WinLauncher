+/// Xbox user authentication accepts a t= ticket for a compact JWE when the
+/// original d= delegation ticket receives HTTP 400. Do not change opaque
+/// tickets or stored credentials.
+pub fn xbox_user_auth_retry_ticket(ticket: &str) -> Option<String> {
+    let bare = ticket.strip_prefix("d=")?;
+    is_compact_jwe(bare).then(|| format!("t={bare}"))
+}
