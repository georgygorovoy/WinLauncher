<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded into standalone_helper's __TEXT,__info_plist section. macOS 27
     never puts windows of an executable without an Info.plist on screen, so the
     Microsoft sign-in window stayed invisible. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>org.winlauncher.xbox-helper</string>
	<key>CFBundleName</key>
	<string>Microsoft sign-in</string>
	<key>CFBundleExecutable</key>
	<string>standalone_helper</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
